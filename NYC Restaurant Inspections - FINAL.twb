      <column caption='Is Graded' datatype='boolean' name='[Calculation_0113530521001984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([grade]) AND [grade] !=&quot;&quot;' />
      </column>
      <column caption='Season' datatype='string' name='[Calculation_0113530521792513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([INSPECTION DATE]) IN (12,1,2) THEN &quot;Winter&quot;&#10;ELSEIF MONTH([INSPECTION DATE]) IN (3,4,5) THEN &quot;Spring&quot;&#10;ELSEIF MONTH([INSPECTION DATE]) IN (6,7,8) THEN &quot;Summer&quot;&#10;ELSE &quot;Fall&quot;&#10;END' />
      </column>
      <column caption='Grade Color' datatype='string' name='[Calculation_0113530521894914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[grade]' />
      </column>
      <column caption='Income Tier' datatype='string' name='[Calculation_0113530521956355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [median_income] &lt; 50000 THEN &quot;Low (&lt;$50K)&quot;&#10;ELSEIF [median_income] &lt; 80000 THEN &quot;Middle ($50K–$80K)&quot;&#10;ELSEIF [median_income] &lt; 110000 THEN &quot;Upper-middle ($80K–$110K)&quot;&#10;ELSE &quot;High ($110K+)&quot;&#10;END' />
      </column>
      <column caption='% Grade A' datatype='real' name='[Calculation_0113530528935941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [grade] = &quot;A&quot; THEN 1 ELSE 0 END) / &#10;SUM(IF [grade] IN (&quot;A&quot;,&quot;B&quot;,&quot;C&quot;) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Initial Grade Was B or C' datatype='boolean' name='[Calculation_0113530598313990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[grade] = &quot;B&quot; OR [grade] = &quot;C&quot;' />
      </column>
