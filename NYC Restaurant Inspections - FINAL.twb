    <worksheet name='Household Income vs. Health Score Scatter Plot'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' italic='true'>Household Income vs. Health Score Scatter Plot</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='final_restaurant_dataset (2)' name='federated.1b6vkev1mmwoxv10twaj60taatpf' />
          </datasources>
          <datasource-dependencies datasource='federated.1b6vkev1mmwoxv10twaj60taatpf'>
            <column caption='Boro' datatype='string' name='[BORO]' role='dimension' type='nominal' />
            <column caption='Camis' datatype='string' default-role='measure' default-type='quantitative' name='[CAMIS]' role='dimension' type='nominal' />
            <column caption='Zipcode' datatype='string' default-format='*00000' name='[ZIPCODE]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
            <column-instance column='[median_income]' derivation='Avg' name='[avg:median_income:qk]' pivot='key' type='quantitative' />
            <column-instance column='[score]' derivation='Avg' name='[avg:score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CAMIS]' derivation='CountD' name='[ctd:CAMIS:qk]' pivot='key' type='quantitative' />
            <column caption='Median Income' datatype='real' name='[median_income]' role='measure' type='quantitative' />
            <column-instance column='[BORO]' derivation='None' name='[none:BORO:nk]' pivot='key' type='nominal' />
            <column-instance column='[ZIPCODE]' derivation='None' name='[none:ZIPCODE:nk]' pivot='key' type='nominal' />
            <column caption='Score' datatype='real' name='[score]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1b6vkev1mmwoxv10twaj60taatpf].[avg:median_income:qk]' included-values='in-range'>
            <min>0.0</min>
            <max>250001.0</max>
          </filter>
          <filter class='categorical' column='[federated.1b6vkev1mmwoxv10twaj60taatpf].[none:BORO:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:BORO:nk]' member='&quot;Bronx&quot;' />
              <groupfilter function='member' level='[none:BORO:nk]' member='&quot;Brooklyn&quot;' />
              <groupfilter function='member' level='[none:BORO:nk]' member='&quot;Manhattan&quot;' />
              <groupfilter function='member' level='[none:BORO:nk]' member='&quot;Queens&quot;' />
              <groupfilter function='member' level='[none:BORO:nk]' member='&quot;Staten Island&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1b6vkev1mmwoxv10twaj60taatpf].[none:BORO:nk]</column>
            <column>[federated.1b6vkev1mmwoxv10twaj60taatpf].[avg:median_income:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.1b6vkev1mmwoxv10twaj60taatpf].[avg:score:qk]' field-type='quantitative' max='28.0' min='12.0' range-type='fixed' scope='rows' type='space' />
            <format attr='title' class='0' field='[federated.1b6vkev1mmwoxv10twaj60taatpf].[avg:median_income:qk]' scope='cols' value='Median Household Income by ZIP Code' />
            <format attr='title' class='0' field='[federated.1b6vkev1mmwoxv10twaj60taatpf].[avg:score:qk]' scope='rows' value='Average Inspection Score' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.1b6vkev1mmwoxv10twaj60taatpf].[avg:median_income:qk]' value='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' />
          </style-rule>
          <style-rule element='refline'>
            <format attr='fill-above' id='refline0' value='#00000000' />
            <format attr='fill-below' id='refline0' value='#00000000' />
