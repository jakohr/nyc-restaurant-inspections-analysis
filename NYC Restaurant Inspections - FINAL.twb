    <dashboard enable-sort-zone-taborder='true' name='2 - Income &amp; Geography'>
      <style />
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='9' param='horz' type-v2='layout-flow' w='98666' x='667' y='889'>
            <zone h='98222' id='7' type-v2='layout-basic' w='61333' x='667' y='889'>
              <zone h='93889' id='3' param='vert' type-v2='layout-flow' w='61333' x='667' y='5222'>
                <zone h='93889' id='6' name='Household Income vs. Health Score Scatter Plot' w='61333' x='667' y='5222'>
                  <layout-cache minheight='198' type-h='scalable' type-w='fixed' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone forceUpdate='true' h='4333' id='5' type-v2='text' w='61333' x='667' y='889'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='18'>Income &amp; Geography Analysis</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='448' h='98222' id='8' is-fixed='true' param='vert' type-v2='layout-flow' w='37333' x='62000' y='889'>
              <zone h='14000' id='10' name='Household Income vs. Health Score Scatter Plot' pane-specification-id='0' param='[federated.1b6vkev1mmwoxv10twaj60taatpf].[none:BORO:nk]' type-v2='color' w='37333' x='62000' y='889'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='11778' id='11' name='Household Income vs. Health Score Scatter Plot' pane-specification-id='0' param='[federated.1b6vkev1mmwoxv10twaj60taatpf].[ctd:CAMIS:qk]' type-v2='size' w='37333' x='62000' y='14889'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='16111' id='19' type-v2='text' w='37333' x='62000' y='26667'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Key Findings:</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>R = -0.24</run>
                  <run fontcolor='#000000' fontsize='12'> (negative relationship — higher income = lower/better scores)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>R² = 0.056 </run>
                  <run fontcolor='#000000' fontsize='12'>(income explains about 5.6% of score variation)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>P-value = 0.001</run>
                  <run fontcolor='#000000' fontsize='12'> (statistically significant)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='467' forceUpdate='true' h='52778' id='12' is-fixed='true' type-v2='text' w='37333' x='62000' y='42778'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='14'>H3 Finding: Income vs. Inspection Scores</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='14'>Our analysis of 187 NYC zip codes found a modest but statistically significant negative relationship between neighborhood income and inspection scores (R = -0.24, R² = 0.056, p = 0.001), partially supporting Hypothesis 1.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='14'>Restaurants in lower income zip codes (below $87,365) averaged a score of 18.43 versus 17.06 in higher income zip codes, a difference of 1.37 points. However even within the wealthiest zip codes (above $150,000 median income), scores ranged widely from 8.0 to 24.81, confirming that high income alone does not guarantee food safety. Since income explains only 5.6% of score variation, cuisine type and restaurant management appear to be stronger drivers of inspection outcomes than neighborhood wealth.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
