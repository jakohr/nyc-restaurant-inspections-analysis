              <formatted-text>
                <run>Borough (Key)&#10;</run>
              </formatted-text>
            </format>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.1b6vkev1mmwoxv10twaj60taatpf].[none:BORO:nk]' />
              <size column='[federated.1b6vkev1mmwoxv10twaj60taatpf].[ctd:CAMIS:qk]' />
              <lod column='[federated.1b6vkev1mmwoxv10twaj60taatpf].[none:ZIPCODE:nk]' />
